# Python artifacts
__pycache__/

# Synthesis & Simulation dumps
synth_work/
sim/
reports/
venv/

# Results: keep the plots/summaries/solution CSVs per FFT size, plus the
# combined cross-size files; everything else (RTL/synth_work/solution_logs
# zips, .npy/.npz dumps) stays ignored.
results/*
!results/fft_*
results/fft_*/*
!results/fft_*/*.png
!results/fft_*/summary.txt
!results/fft_*/*.csv
!results/all_pareto_solutions.csv
!results/comparison_all_fft_sizes.png
!results/comprehensive_summary.txt
# compare_precision_tracks_asic.py output and paper_figures_asic.py figures
!results/asic_fp16_fp32_mixed_comparison_*
!results/asic_fig*.pdf
!results/asic_fig*.png
!results/asic_best_designs.txt

# Log files
*.log
fp16_baseline/synth/fp16_synth_artifacts.zip
fp32_baseline/synth/fp32_synth_artifacts.zip
# Large synthesis artifacts
fp16_baseline/synth/*.zip
fp32_baseline/synth/*.zip

